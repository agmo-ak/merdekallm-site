{
  "permissions": {
    "allow": [
      "Bash(python3 build.py)",
      "Bash(python3 -m http.server 8420)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_generated.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rebuild.py\"",
            "timeout": 60,
            "statusMessage": "Rebuilding site"
          }
        ]
      }
    ]
  }
}
